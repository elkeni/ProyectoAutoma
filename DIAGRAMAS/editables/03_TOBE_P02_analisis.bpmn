<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="D5_Definitions" targetNamespace="https://segale.example/procesos" exporter="Modelador Ságale Abogados">
  <bpmn:error id="p2_error_ia_Error" name="p2 error ia" errorCode="P2_ERROR_IA"/>
  <bpmn:error id="p2_error_descarga_Error" name="p2 error descarga" errorCode="P2_ERROR_DESCARGA"/>
  <bpmn:message id="p2_respuesta_Message" name="Documentos corregidos"/>
  <bpmn:process id="D5_Process" name="03_TOBE_P02_analisis" isExecutable="false">
    <bpmn:documentation>Subproceso P02: Ingesta con Agente A0, enmascaramiento PII, análisis documental con Agente A1 (Gemini + Structured Output), capa de decisión con umbrales y puntos HITL jurídicos (p2_legal y subsanaciones).</bpmn:documentation>
    <bpmn:laneSet id="D5_LaneSet">
      <bpmn:lane id="D5_Lane_1" name="n8n, Agente A0 y Agente A1 (Análisis y RAG)">
        <bpmn:flowNodeRef>p2_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_documentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_version</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_agente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_parser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_json</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_suficiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_error_ia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_error_descarga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_fallo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="D5_Lane_2" name="Equipo jurídico · revisión y subsanación (HITL)">
        <bpmn:flowNodeRef>p2_revision_fallo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_legal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_subsanar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_viable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_fin_viable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_fin_descartada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_subsanacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_esperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_respuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_archivar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_fin_abandono</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p2_inicio" name="Registro de P01">
      <bpmn:outgoing>D5_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="p2_documentos" name="Obtener recaudos con A0&#10;y compuerta PII">
      <bpmn:incoming>D5_Flow_1</bpmn:incoming>
      <bpmn:incoming>D5_Flow_22</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_version" name="Validar y registrar&#10;versión corregida">
      <bpmn:incoming>D5_Flow_21</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_agente" name="Agente A1: Calificación con RAG,&#10;Gemini y Capa de Decisión">
      <bpmn:incoming>D5_Flow_2</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_parser" name="Validar estructura&#10;de la salida JSON">
      <bpmn:incoming>D5_Flow_3</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_json" name="¿JSON válido?">
      <bpmn:incoming>D5_Flow_4</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>D5_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_suficiente" name="¿Suficiente?">
      <bpmn:incoming>D5_Flow_5</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>D5_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="p2_error_ia" attachedToRef="p2_agente" cancelActivity="true">
      <bpmn:outgoing>D5_Flow_8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="p2_error_ia_Def" errorRef="p2_error_ia_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="p2_error_descarga" attachedToRef="p2_documentos" cancelActivity="true">
      <bpmn:outgoing>D5_Flow_9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="p2_error_descarga_Def" errorRef="p2_error_descarga_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="p2_fallo" name="Registrar fallo técnico&#10;o salida JSON inválida">
      <bpmn:incoming>D5_Flow_7</bpmn:incoming>
      <bpmn:incoming>D5_Flow_8</bpmn:incoming>
      <bpmn:incoming>D5_Flow_9</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p2_revision_fallo" name="Revisar documentos&#10;y resolver el incidente (HITL)">
      <bpmn:incoming>D5_Flow_10</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p2_legal" name="Revisar evidencia&#10;y gravámenes (HITL)">
      <bpmn:incoming>D5_Flow_6</bpmn:incoming>
      <bpmn:incoming>D5_Flow_11</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p2_subsanar" name="¿Subsanar?">
      <bpmn:incoming>D5_Flow_13</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>D5_Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_viable" name="¿Viable?">
      <bpmn:incoming>D5_Flow_15</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>D5_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p2_fin_viable" name="Continúa P03">
      <bpmn:incoming>D5_Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="p2_fin_descartada" name="Operación descartada">
      <bpmn:incoming>D5_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p2_subsanacion" name="Solicitar subsanación&#10;y detallar observaciones (HITL)">
      <bpmn:incoming>D5_Flow_12</bpmn:incoming>
      <bpmn:incoming>D5_Flow_14</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="p2_esperar">
      <bpmn:incoming>D5_Flow_18</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_19</bpmn:outgoing>
      <bpmn:outgoing>D5_Flow_20</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="p2_respuesta" name="Documentos corregidos">
      <bpmn:incoming>D5_Flow_19</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p2_respuesta_Def" messageRef="p2_respuesta_Message"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="p2_plazo" name="5 días sin respuesta (P5D)">
      <bpmn:incoming>D5_Flow_20</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="p2_plazo_Def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="p2_archivar" name="Archivar por&#10;falta de subsanación (HITL)">
      <bpmn:incoming>D5_Flow_23</bpmn:incoming>
      <bpmn:outgoing>D5_Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p2_fin_abandono" name="Archivada por falta de subsanación">
      <bpmn:incoming>D5_Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D5_Flow_1" sourceRef="p2_inicio" targetRef="p2_documentos"/>
    <bpmn:sequenceFlow id="D5_Flow_2" sourceRef="p2_documentos" targetRef="p2_agente"/>
    <bpmn:sequenceFlow id="D5_Flow_3" sourceRef="p2_agente" targetRef="p2_parser"/>
    <bpmn:sequenceFlow id="D5_Flow_4" sourceRef="p2_parser" targetRef="p2_json"/>
    <bpmn:sequenceFlow id="D5_Flow_5" sourceRef="p2_json" targetRef="p2_suficiente" name="Sí"/>
    <bpmn:sequenceFlow id="D5_Flow_6" sourceRef="p2_suficiente" targetRef="p2_legal" name="Sí"/>
    <bpmn:sequenceFlow id="D5_Flow_7" sourceRef="p2_json" targetRef="p2_fallo" name="No"/>
    <bpmn:sequenceFlow id="D5_Flow_8" sourceRef="p2_error_ia" targetRef="p2_fallo"/>
    <bpmn:sequenceFlow id="D5_Flow_9" sourceRef="p2_error_descarga" targetRef="p2_fallo"/>
    <bpmn:sequenceFlow id="D5_Flow_10" sourceRef="p2_fallo" targetRef="p2_revision_fallo"/>
    <bpmn:sequenceFlow id="D5_Flow_11" sourceRef="p2_revision_fallo" targetRef="p2_legal"/>
    <bpmn:sequenceFlow id="D5_Flow_12" sourceRef="p2_suficiente" targetRef="p2_subsanacion" name="No"/>
    <bpmn:sequenceFlow id="D5_Flow_13" sourceRef="p2_legal" targetRef="p2_subsanar"/>
    <bpmn:sequenceFlow id="D5_Flow_14" sourceRef="p2_subsanar" targetRef="p2_subsanacion" name="Sí"/>
    <bpmn:sequenceFlow id="D5_Flow_15" sourceRef="p2_subsanar" targetRef="p2_viable" name="No"/>
    <bpmn:sequenceFlow id="D5_Flow_16" sourceRef="p2_viable" targetRef="p2_fin_viable" name="Sí"/>
    <bpmn:sequenceFlow id="D5_Flow_17" sourceRef="p2_viable" targetRef="p2_fin_descartada" name="No"/>
    <bpmn:sequenceFlow id="D5_Flow_18" sourceRef="p2_subsanacion" targetRef="p2_esperar"/>
    <bpmn:sequenceFlow id="D5_Flow_19" sourceRef="p2_esperar" targetRef="p2_respuesta"/>
    <bpmn:sequenceFlow id="D5_Flow_20" sourceRef="p2_esperar" targetRef="p2_plazo"/>
    <bpmn:sequenceFlow id="D5_Flow_21" sourceRef="p2_respuesta" targetRef="p2_version"/>
    <bpmn:sequenceFlow id="D5_Flow_22" sourceRef="p2_version" targetRef="p2_documentos"/>
    <bpmn:sequenceFlow id="D5_Flow_23" sourceRef="p2_plazo" targetRef="p2_archivar"/>
    <bpmn:sequenceFlow id="D5_Flow_24" sourceRef="p2_archivar" targetRef="p2_fin_abandono"/>
  </bpmn:process>
  <bpmn:collaboration id="D5_Collaboration">
    <bpmn:participant id="D5_Participant_1" name="Cliente"/>
    <bpmn:participant id="D5_Participant_2" name="Estudio Jurídico Ságale Abogados" processRef="D5_Process"/>
    <bpmn:messageFlow id="D5_MessageFlow_1" name="Solicitud de subsanación al cliente" sourceRef="p2_subsanacion" targetRef="D5_Participant_1"/>
    <bpmn:messageFlow id="D5_MessageFlow_2" name="Documentos corregidos del cliente" sourceRef="D5_Participant_1" targetRef="p2_respuesta"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="D5_Diagram">
    <bpmndi:BPMNPlane id="D5_Plane" bpmnElement="D5_Collaboration">
