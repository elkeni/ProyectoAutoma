      <bpmndi:BPMNEdge id="D6_Flow_5_di" bpmnElement="D6_Flow_5"><di:waypoint x="825" y="416"/><di:waypoint x="705" y="416"/><di:waypoint x="705" y="655"/><di:waypoint x="650" y="655"/><di:waypoint x="650" y="710"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D6_Flow_6_di" bpmnElement="D6_Flow_6"><di:waypoint x="877" y="756"/><di:waypoint x="1100" y="756"/><di:waypoint x="1100" y="645"/><di:waypoint x="1247" y="645"/><di:waypoint x="1247" y="462"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D6_Flow_7_di" bpmnElement="D6_Flow_7"><di:waypoint x="1360" y="416"/><di:waypoint x="1410" y="416"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D6_Flow_8_di" bpmnElement="D6_Flow_8"><di:waypoint x="1436" y="390"/><di:waypoint x="1436" y="308"/><di:waypoint x="1515" y="308"/></bpmndi:BPMNEdge>
