<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="D4_Definitions" targetNamespace="https://segale.example/procesos" exporter="Modelador Ságale Abogados">
  <bpmn:message id="p1_inicio_Message" name="Solicitud HTTP POST"/>
  <bpmn:error id="p1_error_sheets_Error" name="p1 error sheets" errorCode="P1_ERROR_SHEETS"/>
  <bpmn:error id="p1_error_sistema_Error" name="p1 error sistema" errorCode="P1_ERROR_SISTEMA"/>
  <bpmn:process id="D4_Process" name="02_TOBE_P01_registro" isExecutable="false">
    <bpmn:documentation>Subproceso P01 gobernado por reglas deterministas y Agente A0. Valida contrato de 10 campos, normaliza, aplica SHA-256, gestiona idempotencia (201/200/400), Cola_Fallidos, reintentos exponenciales (2, 4 y 8s) y escalamiento HITL.</bpmn:documentation>
    <bpmn:laneSet id="D4_LaneSet">
      <bpmn:lane id="D4_Lane_1" name="n8n, Agente A0 y reglas deterministas">
        <bpmn:flowNodeRef>p1_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_normalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_hash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_existe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_201</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_fin_nueva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_fallidos_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_400</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_fin_invalida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_200</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_fin_duplicada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_error_sheets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_error_sistema</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_reintento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_recuperado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_alertar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="D4_Lane_2" name="Asistente jurídico · incidentes (HITL)">
        <bpmn:flowNodeRef>p1_incidente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_fin_incidente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_inicio" name="Solicitud HTTP POST">
      <bpmn:outgoing>D4_Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p1_inicio_Def" messageRef="p1_inicio_Message"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="p1_validar" name="Validar campos&#10;y adjuntos">
      <bpmn:incoming>D4_Flow_1</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p1_valida" name="¿Válida?">
      <bpmn:incoming>D4_Flow_2</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>D4_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p1_normalizar" name="Normalizar&#10;los datos">
      <bpmn:incoming>D4_Flow_3</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p1_hash" name="Generar clave&#10;SHA-256">
      <bpmn:incoming>D4_Flow_4</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p1_consultar" name="Consultar clave&#10;en Google Sheets">
      <bpmn:incoming>D4_Flow_5</bpmn:incoming>
      <bpmn:incoming>D4_Flow_17</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p1_existe" name="¿Existe?">
      <bpmn:incoming>D4_Flow_6</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>D4_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p1_registrar" name="Registrar en&#10;Solicitudes">
      <bpmn:incoming>D4_Flow_7</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p1_201" name="Responder&#10;201 Created">
      <bpmn:incoming>D4_Flow_8</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p1_fin_nueva" name="Continúa P02">
      <bpmn:incoming>D4_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p1_fallidos_datos" name="Registrar en&#10;Cola_Fallidos">
      <bpmn:incoming>D4_Flow_10</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p1_400" name="Responder 400&#10;y detallar errores">
      <bpmn:incoming>D4_Flow_11</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p1_fin_invalida" name="Entrada inválida">
      <bpmn:incoming>D4_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p1_200" name="Responder 200&#10;sin otra inserción">
      <bpmn:incoming>D4_Flow_13</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p1_fin_duplicada" name="Reenvío atendido">
      <bpmn:incoming>D4_Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="p1_error_sheets" attachedToRef="p1_consultar" cancelActivity="true">
      <bpmn:outgoing>D4_Flow_15</bpmn:outgoing>
      <bpmn:errorEventDefinition id="p1_error_sheets_Def" errorRef="p1_error_sheets_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="p1_error_sistema" attachedToRef="p1_registrar" cancelActivity="true">
      <bpmn:outgoing>D4_Flow_19</bpmn:outgoing>
      <bpmn:errorEventDefinition id="p1_error_sistema_Def" errorRef="p1_error_sistema_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="p1_reintento" name="Error transitorio: reintentar&#10;3 veces: 2, 4 y 8 s">
      <bpmn:incoming>D4_Flow_15</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p1_recuperado" name="¿Recuperado?">
      <bpmn:incoming>D4_Flow_16</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_17</bpmn:outgoing>
      <bpmn:outgoing>D4_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p1_alertar" name="Registrar falla&#10;y alertar al responsable">
      <bpmn:incoming>D4_Flow_18</bpmn:incoming>
      <bpmn:incoming>D4_Flow_19</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p1_incidente" name="Revisar el incidente&#10;y recuperar la solicitud">
      <bpmn:incoming>D4_Flow_20</bpmn:incoming>
      <bpmn:outgoing>D4_Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_fin_incidente" name="Solicitud derivada a revisión">
      <bpmn:incoming>D4_Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D4_Flow_1" sourceRef="p1_inicio" targetRef="p1_validar"/>
    <bpmn:sequenceFlow id="D4_Flow_2" sourceRef="p1_validar" targetRef="p1_valida"/>
    <bpmn:sequenceFlow id="D4_Flow_3" sourceRef="p1_valida" targetRef="p1_normalizar" name="Sí"/>
    <bpmn:sequenceFlow id="D4_Flow_4" sourceRef="p1_normalizar" targetRef="p1_hash"/>
    <bpmn:sequenceFlow id="D4_Flow_5" sourceRef="p1_hash" targetRef="p1_consultar"/>
    <bpmn:sequenceFlow id="D4_Flow_6" sourceRef="p1_consultar" targetRef="p1_existe"/>
    <bpmn:sequenceFlow id="D4_Flow_7" sourceRef="p1_existe" targetRef="p1_registrar" name="No"/>
    <bpmn:sequenceFlow id="D4_Flow_8" sourceRef="p1_registrar" targetRef="p1_201"/>
    <bpmn:sequenceFlow id="D4_Flow_9" sourceRef="p1_201" targetRef="p1_fin_nueva"/>
    <bpmn:sequenceFlow id="D4_Flow_10" sourceRef="p1_valida" targetRef="p1_fallidos_datos" name="No"/>
    <bpmn:sequenceFlow id="D4_Flow_11" sourceRef="p1_fallidos_datos" targetRef="p1_400"/>
    <bpmn:sequenceFlow id="D4_Flow_12" sourceRef="p1_400" targetRef="p1_fin_invalida"/>
    <bpmn:sequenceFlow id="D4_Flow_13" sourceRef="p1_existe" targetRef="p1_200" name="Sí"/>
    <bpmn:sequenceFlow id="D4_Flow_14" sourceRef="p1_200" targetRef="p1_fin_duplicada"/>
    <bpmn:sequenceFlow id="D4_Flow_15" sourceRef="p1_error_sheets" targetRef="p1_reintento"/>
    <bpmn:sequenceFlow id="D4_Flow_16" sourceRef="p1_reintento" targetRef="p1_recuperado"/>
    <bpmn:sequenceFlow id="D4_Flow_17" sourceRef="p1_recuperado" targetRef="p1_consultar" name="Sí"/>
    <bpmn:sequenceFlow id="D4_Flow_18" sourceRef="p1_recuperado" targetRef="p1_alertar" name="No"/>
    <bpmn:sequenceFlow id="D4_Flow_19" sourceRef="p1_error_sistema" targetRef="p1_alertar"/>
    <bpmn:sequenceFlow id="D4_Flow_20" sourceRef="p1_alertar" targetRef="p1_incidente"/>
    <bpmn:sequenceFlow id="D4_Flow_21" sourceRef="p1_incidente" targetRef="p1_fin_incidente"/>
  </bpmn:process>
  <bpmn:collaboration id="D4_Collaboration">
    <bpmn:participant id="D4_Participant_Client" name="Cliente (Comprador / Vendedor)"/>
    <bpmn:participant id="D4_Participant_Study" name="Estudio Jurídico Ságale Abogados" processRef="D4_Process"/>
    <bpmn:messageFlow id="D4_Msg_1" name="Solicitud HTTP POST" sourceRef="D4_Participant_Client" targetRef="p1_inicio"/>
    <bpmn:messageFlow id="D4_Msg_2" name="201 Created" sourceRef="p1_201" targetRef="D4_Participant_Client"/>
    <bpmn:messageFlow id="D4_Msg_3" name="200 OK" sourceRef="p1_200" targetRef="D4_Participant_Client"/>
    <bpmn:messageFlow id="D4_Msg_4" name="400 Bad Request" sourceRef="p1_400" targetRef="D4_Participant_Client"/>
  </bpmn:collaboration>
