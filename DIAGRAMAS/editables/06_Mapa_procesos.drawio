        <mxCell id="9" value="P02 · Análisis y Calificación (A0 + A1)" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;fontFamily=Inter;fontSize=25;fontColor=#087F66;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="678" y="45" width="476" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="• Ingesta Drive, Compuerta PII y versionado (A0)&lt;br&gt;• Calificación RAG + IA y salida JSON validada (A1)&lt;br&gt;• Capa de Decisión decide() con umbral de riesgo&lt;br&gt;• HITL jurídico: gravámenes SUNARP y plazo P5D" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;fontFamily=Inter;fontSize=20;fontColor=#12243A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
