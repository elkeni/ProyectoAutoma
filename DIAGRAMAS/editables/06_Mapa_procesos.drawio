        <mxCell id="11" value="P03 · Minuta y Cierre Notarial (A2)" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;fontFamily=Inter;fontSize=25;fontColor=#B96516;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
