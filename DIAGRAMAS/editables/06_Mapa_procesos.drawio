        <mxCell id="7" value="P01 · Registro e Idempotencia (A0)" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=none;fillColor=none;fontFamily=Inter;fontSize=25;fontColor=#2563EB;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
